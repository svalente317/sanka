// -*- mode: Java; -*-
package sanka.util;

class DateFormat {
    /*
     * Supported conversion specifiers:
     *   %a %A   abbreviated / full weekday name
     *   %b %B   abbreviated / full month name
     *   %d %e   day of month (1-31)
     *   %H      hour, 24h (0-23)
     *   %I      hour, 12h (1-12)
     *   %m      month (1-12)
     *   %M      minute (0-59)
     *   %n %t   whitespace (any amount, including none)
     *   %p      AM/PM
     *   %S      second (0-60, allows a leap second)
     *   %y      2-digit year
     *   %Y      4-digit year
     *   %z      numeric UTC offset (+HHMM, +HH:MM, +HH, or "Z"
     *   %%      a literal '%'
     */
    static boolean parse(String s, String format, DateTime results) {
        results.clear();
        var si = 0;
        var fi = 0;
        var pm_flag = -1;
        var have_12h = false;
        var out = new int[](1);
        var next = 0;
        var names;
        var idx;

        while format[fi] != 0 {

            // Literal whitespace in the format matches any amount
            // (including zero) of whitespace in the input.
            if StringUtils.isSpace(format[fi]) {
                fi = skip_space(format, fi);
                si = skip_space(s, si);
                continue;
            }

            // Literal, non-'%' characters must match exactly.
            if format[fi] != '%' {
                if s[si] != format[fi] {
                    return false;
                }
                fi++;
                si++;
                continue;
            }

            // format[fi] == '%': look at the conversion specifier.
            fi++;
            switch format[fi] {
            case 0:
                return false;

            case '%':
                if s[si] != '%' {
                    return false;
                }
                si++;
                break;

            case 'n':
            case 't':
                si = skip_space(s, si);
                break;

            case 'Y':
                next = parse_uint(s, si, 4, out);
                if next == si {
                    return false;
                }
                si = next;
                results.year = out[0] - 1900;
                break;

            case 'y':
                next = parse_uint(s, si, 2, out);
                if next == si {
                    return false;
                }
                si = next;
                // POSIX rule: 0-68 -> 2000-2068, 69-99 -> 1969-1999
                var year = out[0];
                results.year = (year <= 68) ? (year + 100) : year;
                break;

            case 'm':
                next = parse_uint(s, si, 2, out);
                var month = out[0];
                if next == si || month < 1 || month > 12 {
                    return false;
                }
                si = next;
                results.month = month - 1;
                break;

            case 'd':
            case 'e':
                si = skip_space(s, si); // %e may have a leading space
                next = parse_uint(s, si, 2, out);
                var day = out[0];
                if next == si || day < 1 || day > 31 {
                    return false;
                }
                si = next;
                results.mday = day;
                break;

            case 'H':
                next = parse_uint(s, si, 2, out);
                var hour = out[0];
                if next == si || hour < 0 || hour > 23 {
                    return false;
                }
                si = next;
                results.hour = hour;
                have_12h = false;
                break;

            case 'I':
                next = parse_uint(s, si, 2, out);
                var hour12 = out[0];
                if next == si || hour12 < 1 || hour12 > 12 {
                    return false;
                }
                si = next;
                results.hour = hour12 % 12; // 12 -> 0
                have_12h = true;
                break;

            case 'M':
                next = parse_uint(s, si, 2, out);
                var minute = out[0];
                if next == si || minute < 0 || minute > 59 {
                    return false;
                }
                si = next;
                results.minute = minute;
                break;

            case 'S':
                next = parse_uint(s, si, 2, out);
                var second = out[0];
                if next == si || second < 0 || second > 60 {
                    return false;
                }
                si = next;
                results.second = second;
                break;

            case 'p':
                var len = match_name_at(s, si, "AM");
                if len > 0 {
                    pm_flag = 0;
                    si = si + len;
                    break;
                }
                len = match_name_at(s, si, "PM");
                if len > 0 {
                    pm_flag = 1;
                    si = si + len;
                    break;
                }
                return false;

            case 'z':
                next = match_utc_offset(s, si, out);
                if next == si {
                    return false;
                }
                si = next;
                results.gmtoff = out[0];
                break;

            case 'b':
            case 'B':
            case 'h':
                names = DateNames.get().month_full;
                idx = match_table(s, si, names);
                if idx >= 0 {
                    si = si + names[idx].length();
                    results.month = idx;
                    break;
                }
                names = DateNames.get().month_abbr;
                idx = match_table(s, si, names);
                if idx >= 0 {
                    si = si + names[idx].length();
                    results.month = idx;
                    break;
                }
                return false;

            case 'a':
            case 'A':
                names = DateNames.get().day_full;
                idx = match_table(s, si, names);
                if idx >= 0 {
                    si = si + names[idx].length();
                    results.wday = idx;
                    break;
                }
                names = DateNames.get().day_abbr;
                idx = match_table(s, si, names);
                if idx >= 0 {
                    si = si + names[idx].length();
                    results.wday = idx;
                    break;
                }
                return false;

            default:
                // Unsupported/unknown specifier.
                return false;
            }

            fi++; // move past the specifier character
        }

        // Reconcile a 12-hour clock reading with an AM/PM marker, if both
        // were present in the format string.
        if have_12h && pm_flag == 1 && results.hour < 12 {
            results.hour = results.hour + 12;
        }
        if have_12h && pm_flag == 0 && results.hour == 12 {
            results.hour = 0;
        }
        return true;
    }

    private static int match_name_at(String s, int si, String name) {
        var k = 0;
        for ; name[k] != 0; k++ {
            var a = s[si + k];
            var b = name[k];
            if tolower(a) != tolower(b) {
                return 0;
            }
        }
        return k;
    }

    private static int match_table(String s, int si, String[] table) {
        var best_len = 0;
        var best_idx = -1;
        for var idx = 0; idx < table.length; idx++ {
            var len = match_name_at(s, si, table[idx]);
            if len > best_len {
                best_len = len;
                best_idx = idx;
            }
        }
        if best_idx < 0 {
            return -1;
        }
        return best_idx;
    }

    private static int parse_uint(String s, int si, int max_digits, int[] outp) {
        var value = 0;
        var ndigits = 0;
        var i = si;
        while isdigit(s[i]) && ndigits < max_digits {
            value = value * 10 + (s[i] - '0');
            ndigits++;
            i++;
        }
        if ndigits == 0 {
            return si;
        }
        outp[0] = value;
        return i;
    }

    private static int skip_space(String s, int si) {
        while StringUtils.isSpace(s[si]) {
            si++;
        }
        return si;
    }

    /**
     * Parse a %z field starting at index si: either
     *   - a bare 'Z' (shorthand for UTC, offset 0), or
     *   - a signed numeric offset: +HHMM, +HH:MM, or +HH (also with '-').
     *
     * On success, writes the offset in seconds (east of UTC, so "+0530"
     * becomes +19800) to out[0] and returns the index just past
     * what was consumed. On failure, returns si unchanged.
     */
    private static int match_utc_offset(String s, int si, int[] out) {
        var i = si;
        var sign = 1;
        var hh = 0;
        var mm = 0;

        if s[i] == 'Z' {
            out[0] = 0;
            return i + 1;
        }

        if s[i] == '+' {
            sign = 1;
        } else if s[i] == '-' {
            sign = -1;
        } else {
            return si;
        }
        i++;

        var hh_digits = 0;
        while isdigit(s[i]) && hh_digits < 2 {
            hh = hh * 10 + (s[i] - '0');
            hh_digits++;
            i++;
        }
        if hh_digits == 0 {
            return si;
        }

        /* Optional ':' between hours and minutes, e.g. "+05:30". */
        if s[i] == ':' {
            i++;
        }
        var mm_digits = 0;
        while isdigit(s[i]) && mm_digits < 2 {
            mm = mm * 10 + (s[i] - '0');
            mm_digits++;
            i++;
        }
        // Minutes are optional ("+05" is a valid offset); if present,
        // require exactly two digits so "+053" isn't silently accepted
        // as "+05:03" followed by a stray '3'.
        if mm_digits == 1 {
            return si;
        }
        if hh > 23 || mm > 59 {
            return si;
        }
        out[0] = sign * (hh * 3600 + mm * 60);
        return i;
    }

    private static boolean isdigit(byte c) {
        return c >= '0' && c <= '9';
    }

    private static byte tolower(byte c) {
        return (c >= 'A' && c <= 'Z') ? (c - 'A' + 'a') : c;
    }
}
